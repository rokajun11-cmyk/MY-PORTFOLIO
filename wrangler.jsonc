{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rokajun-com",
  "compatibility_date": "2026-07-03",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Pure static SPA — no Worker entry script, so `assets.directory` points
  // wrangler straight at vite's output. Cloudflare's generated branch used
  // @cloudflare/vite-plugin instead, which relocates the build output; this
  // avoids that extra moving part.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
